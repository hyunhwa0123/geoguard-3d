# Copy this file to .env for local development. Do not use these credentials in production.
POSTGRES_DB=geoguard
POSTGRES_USER=geoguard
POSTGRES_PASSWORD=geoguard_local_only
POSTGRES_PORT=5432
APP_PORT=5173
BACKEND_PORT=8080
TZ=Asia/Seoul

# Applications can use this URL when running directly on the host.
DATABASE_URL=jdbc:postgresql://localhost:5432/geoguard
DATABASE_USERNAME=geoguard
DATABASE_PASSWORD=geoguard_local_only

